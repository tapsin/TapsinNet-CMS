# Uygulama
APP_NAME="TapsinNet"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Istanbul
APP_KEY=

# Çoklu dil
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr

# Veritabanı (web kökü DIŞINDA)
DB_DATABASE=
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL
DB_FOREIGN_KEYS=true
DB_BUSY_TIMEOUT=5000

# Sayfalama
APP_PER_PAGE=9
ADMIN_PER_PAGE=20
HOME_RAIL_LIMIT=5

# Oturum / HTTPS kullanıyorsanız true yapın
SESSION_NAME=tapsinnet_sid
SESSION_SECURE=false
SESSION_LIFETIME=7200

# Ters proxy arkasındaysanız (nginx/CDN) true yapın
TRUST_PROXY=false

# HTTPS aktifse
HSTS=
CSP_UPGRADE=false
