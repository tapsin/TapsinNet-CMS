function seedSettings(): void
{
    $n = 0;
    foreach (defaultSettings() as [$key, $tr, $en, $type, $group]) {
        $exists = Database::value('SELECT COUNT(*) FROM settings WHERE key = :k', ['k' => $key], 0);
        if ((int) $exists === 0) {
            Settings::set($key, $tr, $en, $type, $group);
            $n++;
        }
    }
    ok($n . ' ayar eklendi.');
}

