#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * TapsinNet konsol aracı
 *
 *   php bin/console install              kurulum + admin hesabı
 *   php bin/console migrate             şemayı uygular (idempotent)
 *   php bin/console seed                 örnek içerik yükler
 *   php bin/console admin:create         yeni yönetici oluşturur
 *   php bin/console modules [--on|--off=slug]  modül durumu
 *   php bin/console optimize             sqlite bakımı (VACUUM/ANALYZE)
 *   php bin/console backup               veritabanı yedeği
 *   php bin/console check                ortam ve yapılandırma kontrolü
 */

if (PHP_SAPI !== 'cli') {
    exit("Bu araç yalnızca komut satırından çalışır.\n");
}

require dirname(__DIR__) . '/bootstrap/app.php';

use Core\Config;
use Core\Database;
use Core\Application;
use Core\Auth;
use Core\ModuleRegistry;
use Core\Model;
use Models\{User, Module, Settings, Service, Project, Certificate, GalleryItem, Video, News,
             Profile, Testimonial, FaqItem, SocialPost, Page};

$command = $argv[1] ?? 'help';
$args    = array_slice($argv, 2);

function out(string $m = ''): void { echo $m . PHP_EOL; }
function ok(string $m): void    { echo "  ✓ " . $m . PHP_EOL; }
function fail(string $m): void  { echo "  ✗ " . $m . PHP_EOL; }
function step(string $m): void  { echo PHP_EOL . "▸ " . $m . PHP_EOL; }
function head(string $m): void  { echo PHP_EOL . "\033[1m" . $m . "\033[0m" . PHP_EOL; }

/** .env dosyasını üretir. */
function writeEnv(string $name, string $url, string $env, string $debug, bool $secure): int
{
    $path = Application::basePath('.env');
    $key  = 'base64:' . base64_encode(random_bytes(32));

    $content = <<<ENV
APP_NAME="$name"
APP_ENV=$env
APP_DEBUG=$debug
APP_URL=$url
APP_TIMEZONE=Europe/Istanbul
APP_KEY="$key"

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr

DB_DATABASE=
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL
DB_FOREIGN_KEYS=true

APP_PER_PAGE=9
ADMIN_PER_PAGE=20
HOME_RAIL_LIMIT=5

SESSION_NAME=tapsinnet_sid
SESSION_SECURE=$secure
SESSION_LIFETIME=7200
TRUST_PROXY=false
HSTS=
CSP_UPGRADE=false

ENV;

    if (is_file($path)) {
        $backup = $path . '.bak-' . date('Ymd-His');
        copy($path, $backup);
        out("  ! Mevcut .env yedeklendi: " . basename($backup));
    }

    return file_put_contents($path, $content);
}

/** Şemayı uygular. */
function migrate(bool $fresh = false): void
{
    $db = Database::connection();

    if ($fresh) {
        $tables = $db->query("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'")->fetchAll();
        $db->exec('PRAGMA foreign_keys = OFF');
        foreach ($tables as $t) {
            $db->exec('DROP TABLE IF EXISTS "' . $t['name'] . '"');
        }
        $db->exec('PRAGMA foreign_keys = ON');
        out("  · Mevcut tablolar temizlendi.");
    }

    $sql  = file_get_contents(Application::basePath('database/schema.sql'));
    $db->exec($sql);

    $tables = $db->query("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'")->fetchAll();
    ok(count($tables) . ' tablo hazır: ' . implode(', ', array_column($tables, 'name')));

    Model::flushColumnCache();
}

/** Modül kayıtlarını config ile eşitler. */
function syncModules(): void
{
    $existing = [];
    foreach (Database::select('SELECT slug FROM modules') as $r) {
        $existing[(string) $r['slug']] = true;
    }

    $order = 0;
    foreach (Config::get('modules', []) as $slug => $def) {
        if (!isset($existing[$slug])) {
            Database::execute(
                'INSERT INTO modules (slug, is_active, sort_order, created_at, updated_at)
                 VALUES (:s, 1, :o, :c, :u)',
                ['s' => $slug, 'o' => $order, 'c' => now(), 'u' => now()]
            );
        } else {
            Database::execute('UPDATE modules SET sort_order = :o WHERE slug = :s', ['o' => $order, 's' => $slug]);
        }
        $order++;
    }
    ok(count(Config::get('modules', [])) . ' modül kaydı hazır.');
    ModuleRegistry::flush();
}

