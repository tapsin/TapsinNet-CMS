// =============================================================================
//  KOMUT YÖNLENDİRİCİ
// =============================================================================

switch ($command) {
    case 'install':
        head('TapsinNet kurulumu');

        step('Yapılandırma');
        $url = $args[0] ?? 'http://localhost:8000';
        writeEnv('TapsinNet', $url, 'production', 'false', str_starts_with($url, 'https://'));
        ok('.env oluşturuldu (' . $url . ')');

        // .env yeniden yüklensin
        \Core\Env::load(Application::basePath('.env'));
        Config::loadFrom(Application::basePath('config'));
        Config::set('app.debug', false);

        step('Veritabanı');
        migrate(false);

        step('Modüller ve ayarlar');
        syncModules();
        seedSettings();

        step('Yönetici hesabı');
        $email    = $args[1] ?? null;
        $password = $args[2] ?? null;

        if ($email === null) {
            // etkileşimli
            if (function_exists('readline')) {
                $email = trim((string) readline('E-posta: '));
                $suggest = rtrim(preg_replace('/[^A-Za-z0-9]/', '', $email) ?: 'admin', 'abcdefghijklmnopqrstuvwxyz');
                $password = (string) readline("Parola (en az 12 karakter, örn. {$suggest}!2026): ");
            }
        }
        $email    = $email ?: 'admin@example.com';
        $password = $password ?: 'admin123';

        if (User::emailExists($email)) {
            ok('Hesap zaten var: ' . $email);
        } else {
            User::create([
                'name'          => 'Yönetici',
                'username'      => 'admin',
                'email'         => mb_strtolower(trim($email)),
                'password_hash' => Auth::hash($password),
                'role'          => 'admin',
                'is_active'     => 1,
            ]);
            ok('Yönetici oluşturuldu: ' . $email);
        }

        step('Örnek içerik');
        seedContent();

        head('Kurulum tamamlandı');
        out('  Panel : ' . $url . '/admin');
        out('  E-posta: ' . $email);
        out('  Parola : ' . ($args[2] ?? $password));
        out('');
        out('  ! Production kullanıyorsanız APP_DEBUG=false olduğunu ve HTTPS');
        out('    kullandığınızda SESSION_SECURE=true yaptığınızı doğrulayın.');
        break;

    case 'migrate':
        head('Şema güncelleniyor');
        migrate(in_array('--fresh', $args, true));
        syncModules();
        Model::flushColumnCache();
        ModuleRegistry::flush();
        break;

    case 'seed':
        head('Örnek içerik yükleniyor');
        syncModules();
        seedSettings();
        seedContent();
        break;

    case 'admin:create':
        head('Yeni yönetici');
        $email    = $args[0] ?? trim((string) (function_exists('readline') ? readline('E-posta: ') : ''));
        $password = $args[1] ?? '';

        if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
            fail('Geçerli bir e-posta girin.');
            exit(1);
        }
        if (User::emailExists($email)) {
            fail('Bu e-posta zaten kullanımda.');
            exit(1);
        }
        if (mb_strlen($password) < (int) Config::get('security.password.min_length', 12)) {
            fail('Parola en az ' . Config::get('security.password.min_length', 12) . ' karakter olmalı.');
            exit(1);
        }

        $name = $args[2] ?? 'Yönetici';
        User::create([
            'name'          => $name,
            'email'         => mb_strtolower(trim($email)),
            'password_hash' => Auth::hash($password),
            'role'          => 'admin',
            'is_active'     => 1,
        ]);
        ok('Oluşturuldu: ' . $email);
        break;

    case 'modules':
        head('Modül durumu');
        if (isset($args[0]) && str_starts_with($args[0], '--off=')) {
            $slug = substr($args[0], 6);
            Module::setModuleActive($slug, false);
            ok($slug . ' pasif yapıldı.');
            break;
        }
        if (isset($args[0]) && str_starts_with($args[0], '--on=')) {
            $slug = substr($args[0], 5);
            Module::setModuleActive($slug, true);
            ok($slug . ' aktif yapıldı.');
            break;
        }
        foreach (Module::catalog() as $m) {
            $state = $m['is_active'] ? "\033[32mAKTIF\033[0m" : "\033[31mpasif\033[0m";
            printf("  %-16s %s  %s\n", $m['slug'], $state, ModuleRegistry::desc($m['slug']));
        }
        break;

    case 'optimize':
        head('Veritabanı bakımı');
        $db = Database::connection();
        $t  = microtime(true);
        $db->exec('VACUUM');
        $db->exec('ANALYZE');
        $count = $db->query("SELECT COUNT(*) FROM sqlite_master")->fetchColumn();
        ok('VACUUM + ANALYZE tamamlandı (' . round((microtime(true) - $t) * 1000) . ' ms, ' . $count . ' nesne)');
        // WAL dosyalarını temizle
        foreach (['-wal', '-shm'] as $suffix) {
            @unlink(Database::connection()->getAttribute(PDO::ATTR_CONNECTION_STATUS) ? '' : '');
        }
        break;

    case 'backup':
        head('Yedek alınıyor');
        $source = Config::get('database.connections.sqlite.database');
        $stamp  = date('Ymd-His');
        $target = Application::basePath('storage/database/backup-' . $stamp . '.sqlite');

        if (is_file($source)) {
            // WAL içeriğini de almak için VACUUM INTO
            Database::connection()->exec("VACUUM INTO '" . str_replace("'", "''", $target) . "'");
            ok(basename($target) . ' (' . round(filesize($target) / 1024) . ' KB)');
        } else {
            fail('Veritabanı bulunamadı: ' . $source);
            exit(1);
        }
        break;

    case 'check':
        head('Sistem kontrolü');
        $problems = 0;

        // PHP sürümü
        $phpOk = PHP_VERSION_ID >= 80100;
        $phpOk ? ok('PHP ' . PHP_VERSION) : fail('PHP 8.1+ gerekli (bulunan: ' . PHP_VERSION . ')');
        $problems += $phpOk ? 0 : 1;

        // Eklentiler
        foreach (['pdo_sqlite', 'mbstring', 'json', 'fileinfo'] as $ext) {
            $has = extension_loaded($ext);
            $has ? ok('php-' . $ext) : fail('php-' . $ext . ' EKSİK');
            $problems += $has ? 0 : 1;
        }
        foreach (['gd', 'zip'] as $ext) {
            extension_loaded($ext) ? ok('php-' . $ext . ' (isteğe bağlı)') : fail('php-' . $ext . ' eksik — görsel işleme sınırlı');
        }

        // Klasör izinleri
        foreach (['storage', 'storage/logs', 'storage/cache', 'storage/database', 'public/uploads'] as $dir) {
            $path = Application::basePath($dir);
            if (!is_dir($path)) {
                @mkdir($path, 0775, true);
            }
            $w = is_writable($path);
            $w ? ok($dir . ' yazılabilir') : fail($dir . ' YAZILAMAZ');
            $problems += $w ? 0 : 1;
        }

        // Yapılandırma
        $env = Application::basePath('.env');
        is_file($env) ? ok('.env mevcut') : fail('.env YOK');
        $problems += is_file($env) ? 0 : 1;

        $key = (string) Config::get('app.key', '');
        (is_file($env) && $key !== '') ? ok('APP_KEY tanımlı') : fail('APP_KEY boş');
        $problems += ($key !== '') ? 0 : 1;

        $debug = Config::get('app.debug', false);
        Config::get('app.env') === 'production' && !$debug
            ? ok('Production + debug kapalı')
            : fail('APP_DEBUG açıkken production kullanmayın');
        $problems += ($debug ? 1 : 0);

        $secure = Config::get('security.session.cookie_secure', false);
        $isHttps = str_starts_with((string) Config::get('app.url', ''), 'https://');
        ($secure || !$isHttps) ? ok('Oturum çerezi ayarı tutarlı') : fail('HTTPS kullanılıyor ama SESSION_SECURE=false');
        $problems += ($secure || !$isHttps) ? 0 : 1;

        // Veritabanı erişilebilirliği
        $dbFile = (string) Config::get('database.connections.sqlite.database');
        $inWebRoot = str_contains($dbFile, '/public/');
        $inWebRoot ? fail('Veritabanı web kökünün İÇİNDE — güvenlik riski') : ok('Veritabanı web kökü dışında');
        $problems += $inWebRoot ? 1 : 0;

        is_writable($dbFile) || !is_file($dbFile) ? ok('Veritabanı dosyası erişilebilir') : fail('Veritabanı dosyası yazılabilir değil');

        // Uploads koruması
        $uploadHt = Application::basePath('public/uploads/.htaccess');
        is_file($uploadHt) ? ok('uploads/.htaccess mevcut') : fail('uploads/.htaccess YOK — PHP yürütmesi açık olabilir');
        $problems += is_file($uploadHt) ? 0 : 1;

        // Tablolar
        try {
            $tables = Database::connection()->query("SELECT name FROM sqlite_master WHERE type='table'")->fetchAll();
            count($tables) > 5 ? ok(count($tables) . ' tablo') : fail('Tablolar kurulmamış — php bin/console migrate çalıştırın');
        } catch (\Throwable $e) {
            fail('Veritabanı hatası: ' . $e->getMessage());
            $problems++;
        }

        // Modül durumu
        $active = count(array_filter(ModuleRegistry::states()));
        ok($active . ' / ' . count(Config::get('modules', [])) . ' modül aktif');

        head($problems === 0 ? 'Tüm kontroller geçti.' : $problems . ' sorun bulundu.');
        exit($problems === 0 ? 0 : 1);

    case 'help':
    case '--help':
    case '-h':
    default:
        out('TapsinNet konsol');
        out('');
        out('  php bin/console install [url] [email] [password]   Kurulum + admin hesabı');
        out('  php bin/console migrate [--fresh]          Şemayı uygula');
        out('  php bin/console seed                      Örnek içerik yükle');
        out('  php bin/console admin:create <email> <pass> [ad]   Yeni yönetici');
        out('  php bin/console modules [--on=slug|--off=slug]   Modül durumu');
        out('  php bin/console optimize                  VACUUM + ANALYZE');
        out('  php bin/console backup                    Veritabanı yedeği');
        out('  php bin/console check                     Sistem kontrolü');
        out('');
        break;
}
