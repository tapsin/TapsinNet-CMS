# Yükleme klasörü: hiçbir dosya yürütülmez
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
Options -ExecCGI -Indexes
AddType text/plain .php .phtml .phar .html .htm .shtml .cgi .pl .py .sh
